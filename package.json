{
  "name": "mgif-pi-renderdoc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Project-level Pi extension for evidence-driven RenderDoc investigations.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/pi-renderdoc/all.test.ts",
    "test:rdc": "node --test --test-concurrency=1 tests/pi-renderdoc/rdc-integration.test.ts tests/pi-renderdoc/pi-load.integration.test.ts tests/pi-renderdoc/closed-loop.integration.test.ts",
    "test:slp": "node --test tests/pi-superluminal/all.test.ts",
    "test:slp:integration": "node --test --test-concurrency=1 tests/pi-superluminal/slp-integration.test.ts tests/pi-superluminal/pi-load.integration.test.ts",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@types/node": "24.3.0",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
