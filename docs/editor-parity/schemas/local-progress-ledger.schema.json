        },
        "eventId": {
          "$ref": "#/$defs/sha256"
        },
        "replacedDependencyTaskId": {
          "$ref": "#/$defs/identifier"
        },
        "taskId": {
          "$ref": "#/$defs/identifier"
        }
      },
      "required": [
        "eventId",
        "taskId",
        "replacedDependencyTaskId",
        "acceptedGate"
      ],
      "type": "object"
    },
    "storedGateEvent": {
      "additionalProperties": false,
      "properties": {
        "eventId": {
          "$ref": "#/$defs/sha256"
        },
        "gateVerdict": {
          "enum": [
            "ENGINEERING PASS",
            "FAIL/BLOCKED"
          ]
        },
        "phase": {
          "pattern": "^P(?:10|[0-9])$",
          "type": "string"
        },
        "supersedesEventId": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "taskId": {
          "$ref": "#/$defs/identifier"
        }
      },
      "required": [
        "eventId",
        "phase",
        "taskId",
        "gateVerdict",
        "supersedesEventId"
      ],
      "type": "object"
    },
    "storedRecoveryTaskDefinition": {
      "additionalProperties": false,
      "properties": {
        "authorityArtifact": {
          "$ref": "#/$defs/artifact"
        },
        "createdAtUtc": {
          "format": "date-time",
          "type": "string"
        },
        "dependencies": {
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "displayName": {
          "minLength": 1,
          "type": "string"
        },
        "phase": {
          "pattern": "^P(?:10|[0-9])$",
          "type": "string"
        },
        "role": {
          "enum": [
            "repair",
            "integration",
            "gate",
            "reconciliation"
          ]
        },
        "supersedesTaskId": {
          "oneOf": [
            {
              "$ref": "#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "taskId": {
          "pattern": "^task_[A-Za-z0-9._:-]+$",
          "type": "string"
        }
      },
      "required": [
        "taskId",
        "displayName",
        "dependencies",
        "createdAtUtc",
        "phase",
        "role",
        "supersedesTaskId",
        "authorityArtifact"
      ],
      "type": "object"
    },
    "verdict": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "schemaVersion": {
                "const": 1
              }
            },
            "required": [
              "schemaVersion"
            ]
          },
          "then": {
            "allOf": [
              {
                "not": {
                  "required": [
                    "taskDefinitionSha256"
                  ]
                }
              },
              {
                "not": {
                  "required": [
                    "authoritySha256"
                  ]
                }
              },
              {
                "not": {
                  "required": [
                    "gateEvent"
                  ]
                }
              },
              {
                "not": {
                  "required": [
                    "dependencyReplacementsSha256"
                  ]
                }
              }
            ]
          }
        },
        {
          "if": {
            "required": [
              "taskDefinitionSha256"
            ]
          },
          "then": {
            "properties": {
              "schemaVersion": {
                "const": 2
              }
            },
            "required": [
              "taskDefinitionSha256",
              "authoritySha256",
              "gateEvent",
              "dependencyReplacementsSha256"
            ]
          }
        },
        {
          "if": {
            "not": {
              "required": [
                "taskDefinitionSha256"
              ]
            }
          },
          "then": {
            "allOf": [
              {
                "not": {
                  "required": [
                    "authoritySha256"
                  ]
                }
              },
              {
                "not": {
                  "required": [
                    "gateEvent"
                  ]
                }
              },
              {
                "not": {
                  "required": [
                    "dependencyReplacementsSha256"
                  ]
                }
              }
            ]
          }
        }
      ],
      "properties": {
        "authoritySha256": {
          "$ref": "#/$defs/sha256"
        },
        "beforeTaskSha256": {
          "$ref": "#/$defs/sha256"
        },
        "decision": {
          "enum": [
            "completed",
            "failed"
          ]
        },
        "dependencyReplacementsSha256": {
          "$ref": "#/$defs/sha256"
        },
        "displayName": {
          "minLength": 1,
          "type": "string"
        },
        "documentKind": {
          "const": "local-task-verdict"
        },
        "fixedPolicy": {
          "$ref": "#/$defs/fixedPolicy"
        },
        "gateEvent": {
          "oneOf": [
            {
              "$ref": "#/$defs/gateEvent"
            },
            {
              "type": "null"
            }
          ]
        },
        "ledgerId": {
          "const": "mgif-editor-parity"
        },
        "outcome": {
          "enum": [
            "succeeded",
            "failed"
          ]
        },
        "parentBundleId": {
          "$ref": "#/$defs/sha256"
        },
        "parentSnapshotSha256": {
          "$ref": "#/$defs/sha256"
        },
        "reportSha256": {
          "$ref": "#/$defs/sha256"
        },
        "reviewAuthority": {
          "const": "local-automatic-review"
        },
        "reviewExecutionOutcome": {
          "const": "succeeded"
        },
        "schemaVersion": {
          "enum": [
            1,
            2
          ]
        },
        "taskDefinitionSha256": {
          "$ref": "#/$defs/sha256"
        },
        "taskId": {
          "$ref": "#/$defs/identifier"
        }
      },
      "required": [
        "documentKind",
        "schemaVersion",
        "ledgerId",
        "parentBundleId",
        "parentSnapshotSha256",
        "taskId",
        "displayName",
        "beforeTaskSha256",
        "decision",
        "outcome",
        "reportSha256",
        "fixedPolicy",
        "reviewAuthority",
        "reviewExecutionOutcome"
      ],
      "type": "object"
    }
  },
  "$id": "https://mgif.local/schemas/local-progress-ledger.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "$ref": "#/$defs/pointer"
    },
    {
      "$ref": "#/$defs/receipt"
    },
    {
      "$ref": "#/$defs/snapshot"
    },
    {
      "$ref": "#/$defs/state"
    },
    {
      "$ref": "#/$defs/verdict"
    },
    {
      "$ref": "#/$defs/recoveryAuthority"
    }
  ],
  "title": "MGIF Local Editor Progress Ledger Protocol v2"
}
