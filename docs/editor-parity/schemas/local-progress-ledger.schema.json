    "receipt": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "toStatus": {
                "const": "completed"
              }
            },
            "required": [
              "toStatus"
            ]
          },
          "then": {
            "properties": {
              "outcome": {
                "const": "succeeded"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "toStatus": {
                "const": "failed"
              }
            },
            "required": [
              "toStatus"
            ]
          },
          "then": {
            "properties": {
              "outcome": {
                "const": "failed"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "schemaVersion": {
                "const": 1
              }
            },
            "required": [
              "schemaVersion"
            ]
          },
          "then": {
            "allOf": [
              {
                "not": {
                  "required": [
                    "taskDefinition"
                  ]
                }
              },
              {
                "not": {
                  "required": [
                    "authorityArtifact"
                  ]
                }
              },
              {
                "not": {
                  "required": [
                    "gateEvent"
                  ]
                }
              },
              {
                "not": {
                  "required": [
                    "dependencyReplacements"
                  ]
                }
              }
            ]
          }
        },
        {
          "if": {
            "required": [
              "taskDefinition"
            ]
          },
          "then": {
            "properties": {
              "schemaVersion": {
                "const": 2
              }
            },
            "required": [
              "taskDefinition",
              "authorityArtifact",
              "gateEvent",
              "dependencyReplacements"
            ]
          }
        },
        {
          "if": {
            "not": {
              "required": [
                "taskDefinition"
              ]
            }
          },
          "then": {
            "allOf": [
              {
                "not": {
                  "required": [
                    "authorityArtifact"
                  ]
                }
              },
              {
                "not": {
                  "required": [
                    "gateEvent"
                  ]
                }
              },
              {
                "not": {
                  "required": [
                    "dependencyReplacements"
                  ]
                }
              }
            ]
