{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mgif.local/schemas/gltf-editor-acceptance-report-v1.json",
  "title": "MGIF glTF editor acceptance report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runMode",
    "identity",
    "summary",
    "requirements",
    "features",
    "edges",
    "platforms",
    "artifacts"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "runMode": { "enum": ["baseline", "candidate", "final"] },
    "identity": { "$ref": "#/$defs/identity" },
    "summary": { "$ref": "#/$defs/summary" },
    "requirements": {
      "type": "array",
      "minItems": 24,
      "maxItems": 24,
      "items": { "$ref": "#/$defs/result" }
    },
    "features": {
      "type": "array",
      "minItems": 42,
      "maxItems": 42,
      "items": { "$ref": "#/$defs/result" }
    },
    "edges": {
      "type": "array",
      "minItems": 110,
      "maxItems": 110,
      "items": { "$ref": "#/$defs/result" }
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/result" }
    },
    "artifacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/artifact" }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "gitCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "status": {
      "enum": ["pass", "fail", "blocked", "not_run", "not_applicable"]
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startedAt",
        "gitHead",
        "dirtyDiffSha256",
        "referenceCommit",
        "executable",
        "cmake",
        "compiler",
        "os",
        "vulkan",
        "gpu",
        "dpi"
      ],
      "properties": {
        "startedAt": { "type": "string", "format": "date-time" },
        "gitHead": { "$ref": "#/$defs/gitCommit" },
        "dirtyDiffSha256": { "$ref": "#/$defs/sha256" },
        "referenceCommit": { "$ref": "#/$defs/gitCommit" },
        "executable": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "cmake": { "type": "object" },
        "compiler": { "type": "object" },
        "os": { "type": "object" },
        "vulkan": { "type": "object" },
        "gpu": { "type": "array", "items": { "type": "object" } },
        "dpi": { "type": "object" },
        "machineId": { "type": "string" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "requirements", "features", "edges", "platforms", "unresolvedWaivers"],
      "properties": {
        "status": { "$ref": "#/$defs/status" },
        "requirements": { "$ref": "#/$defs/tally24" },
        "features": { "$ref": "#/$defs/tally42" },
        "edges": { "$ref": "#/$defs/tally110" },
        "platforms": { "$ref": "#/$defs/tallyOpen" },
        "unresolvedWaivers": { "type": "integer", "minimum": 0 }
      }
    },
    "tallyBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "passed", "failed", "blocked", "notRun", "notApplicable"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "blocked": { "type": "integer", "minimum": 0 },
        "notRun": { "type": "integer", "minimum": 0 },
        "notApplicable": { "type": "integer", "minimum": 0 }
      }
    },
    "tallyOpen": {
      "allOf": [
        { "$ref": "#/$defs/tallyBase" },
        { "properties": { "total": { "minimum": 1 } } }
      ]
    },
    "tally24": {
      "allOf": [
        { "$ref": "#/$defs/tallyBase" },
        { "properties": { "total": { "const": 24 } } }
      ]
    },
    "tally42": {
      "allOf": [
        { "$ref": "#/$defs/tallyBase" },
        { "properties": { "total": { "const": 42 } } }
      ]
    },
    "tally110": {
      "allOf": [
        { "$ref": "#/$defs/tallyBase" },
        { "properties": { "total": { "const": 110 } } }
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "evidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/status" },
        "evidence": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "message": { "type": "string" },
        "durationSeconds": { "type": "number", "minimum": 0 }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "mediaType", "producer"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "mediaType": { "type": "string", "minLength": 1 },
        "producer": { "type": "string", "minLength": 1 }
      }
    }
  }
}
