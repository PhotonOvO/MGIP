  RendererTargetFence expectedTarget;
  SceneChangeSet changes;
  ApplyPolicy policy;
};

struct ApplyFullSceneSnapshotRequest {
  RendererTargetFence expectedTarget;
  SceneChangeSet fullSnapshotTransition;
