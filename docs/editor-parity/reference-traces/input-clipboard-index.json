  "oracleFindings": {
    "O05": "Escape-only clears selection, permits one final real gizmo preview update, then modeled render attachment sync calls real clearAttachment; no end callback or modeled history entry is emitted.",
    "O06": {
      "escapeThenRelease": "Both callbacks are visible in frame N: menu clear precedes viewport MouseReleased/endDrag, exactly one modeled Transform history entry is produced, and render sync detaches.",
      "releaseThenEscape": "With ConfigInputTrickleEventQueue=true, frame N sees release and commits exactly once while retaining selection/attachment; Escape is exposed in frame N+1, which clears selection and detaches."
    },
    "O07": {
      "noDeliveredRelease": "Focus loss clears ImGui mouse state without MouseReleased; the real drag remains latched, a later physical up is not classified as release, and later modeled selection detach discards it without history.",
      "sameFrameReleaseThenFocusLoss": "Even when mouse-up is queued before focus loss in one input queue, focus clearing prevents application-visible MouseReleased; selection and the latched attachment remain, with no history.",
      "releaseDeliveredBeforeFocusLoss": "A release delivered in the preceding application frame runs real endDrag once and produces one modeled history entry; next-frame focus loss adds no callback and does not clear selection or detach."
    },
